@using WebServiceCore.Models.Entities
@{
}
@model IndexModel
<div id="siteGrid" class="table-responsive">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>
                    Logo
                </th>
                <th>
                    <a asp-page="/Index" asp-route-SortingProperty="@nameof(Site.Name)" asp-route-Descending="@(Model.CurrentSortingProperty == nameof(Site.Name) && !Model.Descending)">
                        Site @(Model.CurrentSortingProperty == nameof(Site.Name) ? (Model.Descending ? "▼" : "▲") : "")
                    </a>
                </th>
                <th>
                    <a asp-page="/Index" asp-route-SortingProperty="@nameof(Site.OwnerId)" asp-route-Descending="@(Model.CurrentSortingProperty == nameof(Site.OwnerId) && !Model.Descending)">
                        Creator @(Model.CurrentSortingProperty == nameof(Site.OwnerId) ? (Model.Descending ? "▼" : "▲") : "")
                    </a>
                </th>
                <th>
                    <a asp-page="/Index" asp-route-SortingProperty="@nameof(Site.Language)" asp-route-Descending="@(Model.CurrentSortingProperty == nameof(Site.Language) && !Model.Descending)">
                        Language @(Model.CurrentSortingProperty == nameof(Site.Language) ? (Model.Descending ? "▼" : "▲") : "")
                    </a>
                </th>
                <th>
                    <a asp-page="/Index" asp-route-SortingProperty="@nameof(Site.LastUpdated)" asp-route-Descending="@(Model.CurrentSortingProperty == nameof(Site.LastUpdated) && !Model.Descending)">
                        Updated @(Model.CurrentSortingProperty == nameof(Site.LastUpdated) ? (Model.Descending ? "▼" : "▲") : "")
                    </a>
                </th>
                <th>
                    Description
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Sites)
            {
                <tr>
                    <td>
                        <img src="~/Icons/@(item.Name).png" width="48px" height="48px" alt="@item.Name" />
                    </td>
                    <td>
                        <div class="site-label">
                            <a asp-page="/Reports/SiteReports" asp-route-site="@item.Name">
                                @item.Name
                            </a>
                            <span class="site-report-count" title="Reports">@(item.ReportCount)</span>
                        </div>
                    </td>
                    <td>
                        @((item.OwnerId?.StartsWith("__deleted__")==true?"Deleted user":item.OwnerId ?? string.Empty).Split('@')[0].Replace('.', ' ').Replace('_', ' '))
                    </td>
                    <td>
                        <img src="~/Langs/@(item.Language).png" height="38px" />
                        @item.Language
                    </td>
                    <td>
                        @item.LastUpdated.ToString("g")
                    </td>
                    <td>
                        @item.Description
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
