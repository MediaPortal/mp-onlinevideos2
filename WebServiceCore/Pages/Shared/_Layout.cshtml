<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OnlineVideos</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebServiceCore.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="portal-header">
        <div class="portal-header-inner">
            <a class="portal-brand" asp-page="/Index"><img src="~/onlinevideos-header.svg" asp-append-version="true" alt="OnlineVideos — Sites, Streams &amp; Community" /></a>
            <div class="portal-account">
            @if(User.Identity.IsAuthenticated){
                <span>@User.Identity.Name</span><form method="post" asp-page="/Login" asp-page-handler="Logout"><button class="btn btn-sm btn-outline-light">Log out</button></form>
            }else{<a asp-page="/Login">Log in</a>}
            </div>
            <nav class="portal-nav" aria-label="Main navigation"><a asp-page="/Index">Sites</a>
            @if(User.Identity.IsAuthenticated){<a asp-page="/Account">Account settings</a>}
            @if(User.IsInRole("admin")){<a asp-page="/Reviews">Reviews</a><a asp-page="/Users">Users</a>}
            </nav>
        </div>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
