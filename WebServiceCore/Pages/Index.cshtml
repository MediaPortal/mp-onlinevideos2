@page
@model IndexModel
@{
    ViewData["Title"] = "Sites";
}

@await Html.PartialAsync("_SiteGridPartial", Model)
<nav aria-label="Provider pages">
    @if (Model.PageNumber > 1) { <a asp-page="/Index" asp-route-PageNumber="@(Model.PageNumber - 1)">Previous</a> }
    @if (Model.HasMore && Model.PageNumber < 50) { <a asp-page="/Index" asp-route-PageNumber="@(Model.PageNumber + 1)">Next</a> }
</nav>
