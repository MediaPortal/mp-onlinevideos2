@page
@model IndexModel
@{
    ViewData["Title"] = "Sites";
}

<div class="catalogue-intro"><h1>Explore OnlineVideos</h1><p class="text-muted">Discover sites, streaming services and community contributions.</p></div>
<div class="catalogue-card">
@await Html.PartialAsync("_SiteGridPartial", Model)
</div>
<nav aria-label="Provider pages">
    @if (Model.PageNumber > 1) { <a asp-page="/Index" asp-route-PageNumber="@(Model.PageNumber - 1)" asp-route-SortingProperty="@Model.CurrentSortingProperty" asp-route-Descending="@Model.Descending">Previous</a> }
    @if (Model.HasMore && Model.PageNumber < 50) { <a asp-page="/Index" asp-route-PageNumber="@(Model.PageNumber + 1)" asp-route-SortingProperty="@Model.CurrentSortingProperty" asp-route-Descending="@Model.Descending">Next</a> }
</nav>
